{
  "name": "manifold-personal-site",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "MANIFOLD — Marzio De Corato. Ricerca, didattica, scrittura e viaggi.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview:build": "node scripts/build.mjs --preview",
    "test": "node --test tests/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check-output.mjs",
    "sync:editorial": "node scripts/sync-editorial.mjs",
    "check:editorial": "node scripts/sync-editorial.mjs --check",
    "build:release": "node scripts/build.mjs --release",
    "preview:editorial": "node scripts/build.mjs --preview --drafts",
    "verify:photos": "node scripts/verify-photos.mjs",
    "test:browser": "python3 tests/browser-explorer.py",
    "test:browser:travels": "python3 tests/browser-travels.py",
    "test:browser:ambient": "python3 tests/browser-ambient.py",
    "test:browser:ambient:webgl": "python3 tests/browser-ambient-webgl.py",
    "security:audit": "node scripts/security-audit.mjs",
    "import:cv": "node scripts/import-cv.mjs",
    "prebuild": "node scripts/import-cv.mjs",
    "prebuild:release": "node scripts/import-cv.mjs",
    "prepreview:build": "node scripts/import-cv.mjs",
    "prepreview:editorial": "node scripts/import-cv.mjs"
  }
}
